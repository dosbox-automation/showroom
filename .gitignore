# Screen recordings from the install and screenshot sessions. Kept
# locally, too large for the repo.
assets/recordings/

# Downloaded archives and installed games. Reproducible from the game
# definitions, hundreds of megabytes, never tracked.
.games-cache/

# Build output and packaging artifacts
build/
dist/

# Python tooling caches
.pytest_cache/
.ruff_cache/

# Session transcripts and scratch space. The global ignore already covers
# these, but it does not travel with a clone, and .sessions/ holds hundreds
# of megabytes that must never reach a public repository.
.sessions/
.workspace/
compile_commands.json
