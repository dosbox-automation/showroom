# Naming rules for the showroom's own C++.
#
# Adapted from dosbox-automation's .clang-tidy, which checks the same one
# thing and nothing else. The single divergence is function naming: the
# engine uses lower_case, inherited from dosbox-staging's C heritage. A Qt
# application calls camelBack methods on every other line
# (setWindowTitle, exec, addWidget), and a codebase that answers those with
# do_thing() reads as two codebases stitched together.
#
# Data members keep lower_case rather than following the functions,
# because most of them mirror a TOML key one for one - cpu_cycles,
# install_type, max_runtime_seconds - and keeping the two spellings
# identical means a field in a game definition and the field that holds it
# are the same string to grep for.

Checks: '-*,readability-identifier-naming'

CheckOptions:
  # Types.
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.NamespaceCase: lower_case

  # Functions, free and member alike: fromToml, isSafeSlug, titlePrecedes.
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack

  # Data: lower_case throughout, non-public members carrying a trailing
  # underscore so a member is never mistaken for a local. Protected counts:
  # a test fixture holds its state protected by necessity, and the reason
  # for the underscore does not change with the access specifier.
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _

  # Compile-time and file-scope constants: kMaxCpuCycles, kAssetGames.
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
